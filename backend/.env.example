# ==========================================
# BASE DE DATOS (POSTGRESQL / SQLITE)
# ==========================================
# 1. Desarrollo local (por defecto usa SQLite si DATABASE_URL no se define):
DATABASE_URL=sqlite:///./jobs.db

# 2. PostgreSQL en Neon (ejemplo con SSL activado):
# DATABASE_URL=postgresql://tu_usuario:tu_password@ep-proyecto-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. PostgreSQL en Render / Railway:
# DATABASE_URL=postgresql://user:password@dpg-xxxx.render.com/jobs_db

# ==========================================
# CONFIGURACIÓN DE CORREO SMTP (CHAMBA / DEVJOBS)
# ==========================================
# Para enviar correos reales, renombra este archivo a '.env' y completa tus datos.

# Opción 1: Gmail SMTP
# 1. Ve a tu cuenta de Google -> Seguridad -> Verificación en 2 pasos -> "Contraseñas de aplicaciones".
# 2. Genera una contraseña para "Correo" y pégala abajo en SMTP_PASSWORD (sin espacios).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_gmail
SMTP_FROM=tu_correo@gmail.com

# Opción 2: Resend SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_tu_api_key_aqui
# SMTP_FROM=onboarding@resend.dev

# Opción 3: SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.tu_api_key_aqui
# SMTP_FROM=verificacion@tudominio.com

# URL pública del backend para el enlace de verificación
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# ==========================================
# SEGURIDAD Y SUPERUSUARIO ADMIN
# ==========================================
JWT_SECRET_KEY=CLAVE_SUPER_SECRETA_PRODUCCION_2026
ADMIN_NAME=Administrador General
ADMIN_EMAIL=admin@chamba.do
ADMIN_PASSWORD=AdminChamba2026!
